[Unit]
Description=Employee360 Admin SPA (nginx-alpine)
After=network-online.target

[Container]
ContainerName=employee360-admin
Image=localhost/employee360-admin:current
Pull=never
PublishPort=127.0.0.1:3003:80

HealthCmd=wget -qO- http://127.0.0.1/healthz || exit 1
HealthInterval=15s
HealthRetries=3
HealthStartPeriod=10s
Notify=healthy

[Service]
Restart=on-failure
RestartSec=5s
TimeoutStartSec=60

[Install]
WantedBy=default.target
