# ==============================================================================
# Employee360 root environment — used by:
#   - docker-compose.yml (Postgres: DATABASE_USER/PASSWORD/NAME/PORT; Redis: REDIS_PASSWORD/PORT)
#   - backend/config/config.go (Viper env bindings; picked up via ../.env when
#     the backend runs from backend/, e.g. `make dev-api`)
#   - clients/admin/vite.config.ts, clients/employee/vite.config.ts
#     (ADMIN_PORT/EMPLOYEE_PORT — read from the actual shell env, not
#     auto-loaded from this file; export or use a tool like `dotenv-cli`
#     if you want this file itself to drive them)
# Copy to .env (gitignored) and adjust for local development.
# ==============================================================================

# --- Server ---
SERVER_PORT=8080
SERVER_HOST=0.0.0.0

# --- Frontend dev server ports (clients/admin, clients/employee) ---
ADMIN_PORT=5173
EMPLOYEE_PORT=5174

# --- Database (matches docker-compose.yml defaults) ---
# Optional: a single URL (postgres:// or postgresql://). When set it OVERRIDES the
# separate DATABASE_HOST/PORT/USER/PASSWORD/NAME/SSLMODE fields below (URL-encode
# special characters in the password; sslmode comes from ?sslmode=...,
# and a URL without sslmode uses "prefer", ignoring DATABASE_SSLMODE).
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/employee360?sslmode=disable
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=employee360
DATABASE_SSLMODE=disable

# --- JWT ---
JWT_SECRET=employee360-super-secret-key-change-in-production

# --- App ---
# Required. Must be set explicitly: development|test relax the JWT secret checks;
# anything else (including unset) is treated as production and rejects the default
# JWT_SECRET. Use production/staging with a real secret when deploying.
APP_ENV=development
LOG_LEVEL=debug
# Public base URL of the web client (used for links in emails, e.g. password reset)
APP_FRONTEND_URL=http://localhost:5173
# Per-app URLs for invitation links (admin/super_admin -> admin app, employee -> employee app).
# Optional: each falls back to APP_FRONTEND_URL when empty
APP_ADMIN_URL=http://localhost:5173
APP_EMPLOYEE_URL=http://localhost:5174

# --- Rate limiting (global, per client IP; health probes exempt) ---
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_SECOND=10
RATE_LIMIT_BURST=20
# Comma-separated proxy IPs/CIDRs whose X-Forwarded-For is trusted for client-IP
# resolution. Leave empty unless running behind a reverse proxy/load balancer;
# trusting an untrusted proxy lets clients spoof their IP and bypass the limiter.
# --- Strict auth throttling (login, forgot/reset password, invitation accept/validate) ---
# Fixed window: attempts per (endpoint, email) and per client IP; lockout lasts at most one window.
# Uses Redis counters when REDIS_ENABLED=true, otherwise in-memory (per instance).
AUTH_RATE_LIMIT_ENABLED=true
AUTH_RATE_LIMIT_PER_ACCOUNT_MAX=5
AUTH_RATE_LIMIT_PER_IP_MAX=30
AUTH_RATE_LIMIT_WINDOW=1m
SERVER_TRUSTED_PROXIES=

# --- CORS (comma-separated origins) ---
CORS_ALLOWED_ORIGINS=*

# --- SMTP (local Mailpit from docker-compose.yml; inbox at http://localhost:8025) ---
# Production example (Resend): SMTP_HOST=smtp.resend.com SMTP_PORT=465
#   SMTP_USERNAME=resend SMTP_PASSWORD=<api key> SMTP_USE_TLS=true
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM="Employee360 <no-reply@example.com>"
SMTP_USE_TLS=false


# --- Bootstrap (cmd/bootstrap, `make bootstrap-admin`) ---
# Required: no defaults, the command fails if email/password are unset.
# Choose a strong password and remove it from .env after the first run.
BOOTSTRAP_SYSTEM_TENANT_NAME=System
BOOTSTRAP_SUPER_ADMIN_EMAIL=superadmin@example.com
BOOTSTRAP_SUPER_ADMIN_PASSWORD=<CHANGE_ME>

# --- Redis (optional; disabled by default) ---
# When REDIS_ENABLED=true the API fails fast at startup if Redis is unreachable.
# When false, health reports redis as "disabled". Start it with `docker compose up -d redis`.
# REDIS_PASSWORD is required in production/staging when enabled.
REDIS_ENABLED=false
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redis
REDIS_DB=0
REDIS_TLS=false
# Optional: redis:// or rediss:// URL; overrides host/port/password/db/tls above
# REDIS_URL=
REDIS_DIAL_TIMEOUT=5s
REDIS_READ_TIMEOUT=3s
REDIS_WRITE_TIMEOUT=3s
REDIS_POOL_SIZE=10
